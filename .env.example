NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://spend:spend@localhost:5432/spend
DATABASE_URL_UNPOOLED=postgresql://spend:spend@localhost:5432/spend
# Operator-only URL used to create/rotate runtime roles. Never expose it to the app.
DATABASE_ADMIN_URL=
# Commercial production separates tenant, trusted-service, and schema-owner roles.
# Local development may keep using DATABASE_URL for all three boundaries.
DATABASE_APP_URL=
DATABASE_SERVICE_URL=
DATABASE_MIGRATION_URL=
SPEND_APP_DB_PASSWORD=
SPEND_SERVICE_DB_PASSWORD=
SPEND_MIGRATION_DB_PASSWORD=
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Gmail uses a separate Google Cloud project because gmail.readonly is a restricted scope.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
AUTH_ALLOWED_GITHUB_IDS=123456
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The GitHub App OAuth client is distinct from the human-login OAuth App.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# Generate a dedicated key with: openssl rand -base64 32
CONNECTOR_ENCRYPTION_KEY=
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SOLO_MONTHLY_PRICE_ID=
STRIPE_SOLO_ANNUAL_PRICE_ID=
STRIPE_STUDIO_MONTHLY_PRICE_ID=
STRIPE_STUDIO_ANNUAL_PRICE_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Spend by YoDev <spend@example.invalid>
CRON_SECRET=replace-with-at-least-16-random-characters
CRON_ENABLED=false
STRIPE_BILLING_ENABLED=false
COMMERCIAL_SIGNUP_ENABLED=false
GMAIL_CONNECTOR_ENABLED=false
WORKFLOW_ENABLED=false
AUTH_TEST_MODE=false
